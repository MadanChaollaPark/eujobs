# Persistent SQLite and resource catalog. Never commit runtime secrets.
DATA_DIR=./data
EUJOBS_SEED=0
EUJOBS_REQUIRE_PAYMENT=1
APP_ORIGIN=http://localhost:3210
TRUST_PROXY=0
RELEASE_SHA=development
# Optional: defaults to DATA_DIR/resources.json
# EUJOBS_RESOURCES_FILE=/absolute/path/resources.json

# Existing Stripe account; all prices are server-side in src/lib/plans.ts.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Hosted checkout does not require a publishable key in the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend (default deployment) or brevo. Explicitly enable after provider verification.
EMAIL_DELIVERY_ENABLED=0
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=EUJobs <notifications@example.org>
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=EUJobs
# Optional operator notifications; contact messages always remain in the admin inbox.
CONTACT_INBOX_EMAIL=

# Optional Google Calendar direct import. Keep disabled until the web OAuth client
# and Calendar API consent configuration are ready. Callback must be exactly:
# https://eujobs.co/api/calendar/google/callback (or APP_ORIGIN + that path).
# Scope: openid + https://www.googleapis.com/auth/calendar.app.created only.
# Online access: no refresh tokens or scheduled Google writes; reconnect to update later.
GOOGLE_CALENDAR_ENABLED=0
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# A securely generated 32-byte key encoded as canonical base64. Back it up separately.
CALENDAR_TOKEN_KEY=
